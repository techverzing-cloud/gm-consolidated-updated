# Resend - email delivery for the contact enquiry form
#
# Enabling checklist:
#   1. Create an account at https://resend.com
#   2. Add and verify the sending domain (e.g. arind.in) via DNS
#   3. Create an API key, then fill in the three values below in a local `.env`
#   4. Repeat the three values in Vercel -> Project -> Settings -> Environment
#      Variables (Production) and redeploy - the form reads them server-side
#   5. Submit a test enquiry on /contact#enquiry and confirm the email arrives
#
# RESEND_FROM_EMAIL must use a domain verified in your Resend account
# (e.g. "G.M. Consolidated <enquiries@arind.in>").
# RESEND_TO_EMAIL receives the form submissions (e.g. your sales inbox).
#
# Values below are placeholders - replace with real credentials in `.env`.
# `.env` is gitignored; never commit secrets.

RESEND_API_KEY=re_xxxxxxxxxxxxxx
RESEND_FROM_EMAIL="G.M. Consolidated <enquiries@example.com>"
RESEND_TO_EMAIL=sales@example.com